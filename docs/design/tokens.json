{
  "$description": "AthleteCore Web design tokens. Dark theme, palette P2. SOURCE OF TRUTH. Edit only through design-system-keeper (skill: design-tokens).",
  "color": {
    "primitive": {
      "neutral": {
        "0":   { "$type": "color", "$value": "#FFFFFF" },
        "100": { "$type": "color", "$value": "#E8E9EB" },
        "200": { "$type": "color", "$value": "#D6D6DC" },
        "300": { "$type": "color", "$value": "#A6A7AF" },
        "400": { "$type": "color", "$value": "#8A8B97" },
        "500": { "$type": "color", "$value": "#69708A" },
        "700": { "$type": "color", "$value": "#292C42" },
        "750": { "$type": "color", "$value": "#2A2E3B" },
        "800": { "$type": "color", "$value": "#202233" },
        "850": { "$type": "color", "$value": "#1B1E27" },
        "900": { "$type": "color", "$value": "#161A25" },
        "950": { "$type": "color", "$value": "#0E1118" }
      },
      "blue": {
        "300": { "$type": "color", "$value": "#6B8CFF" },
        "450": { "$type": "color", "$value": "#3E67FC" },
        "500": { "$type": "color", "$value": "#325EFC" },
        "600": { "$type": "color", "$value": "#2A4FD6" }
      },
      "indigo": {
        "500": { "$type": "color", "$value": "#6259E8" },
        "700": { "$type": "color", "$value": "#5247BE" }
      },
      "violet": {
        "300": { "$type": "color", "$value": "#A98BFA" },
        "500": { "$type": "color", "$value": "#7E3FF7" }
      },
      "green": { "500": { "$type": "color", "$value": "#22C55E" } },
      "amber": { "500": { "$type": "color", "$value": "#F59E0B" } },
      "red": {
        "400": { "$type": "color", "$value": "#F87171" },
        "600": { "$type": "color", "$value": "#DC2626" }
      },
      "cyan": { "400": { "$type": "color", "$value": "#22D3EE" } },
      "tint": {
        "primary":   { "$type": "color", "$value": "#242E5B" },
        "secondary": { "$type": "color", "$value": "#2F2752" },
        "success":   { "$type": "color", "$value": "#203939" },
        "warning":   { "$type": "color", "$value": "#3E332D" },
        "info":      { "$type": "color", "$value": "#203B4D" },
        "danger":    { "$type": "color", "$value": "#422331" }
      }
    },
    "semantic": {
      "surface": {
        "bg":       { "$type": "color", "$value": "{color.primitive.neutral.950}", "$description": "Page and main content background" },
        "sidebar":  { "$type": "color", "$value": "{color.primitive.neutral.900}", "$description": "Sidebar background (lighter than page bg)" },
        "card":     { "$type": "color", "$value": "{color.primitive.neutral.800}", "$description": "Cards and panels" },
        "elevated": { "$type": "color", "$value": "{color.primitive.neutral.700}", "$description": "Dropdowns, modals, row hover" }
      },
      "border": {
        "default": { "$type": "color", "$value": "{color.primitive.neutral.750}", "$description": "Card and panel borders" },
        "divider": { "$type": "color", "$value": "{color.primitive.neutral.850}", "$description": "Subtle separators (header, lists)" },
        "input":   { "$type": "color", "$value": "{color.primitive.neutral.500}", "$description": "Form control borders (3:1 on bg and card)" }
      },
      "text": {
        "primary":      { "$type": "color", "$value": "{color.primitive.neutral.100}", "$description": "Titles and main text" },
        "secondary":    { "$type": "color", "$value": "{color.primitive.neutral.200}", "$description": "Card titles, body" },
        "muted":        { "$type": "color", "$value": "{color.primitive.neutral.300}", "$description": "Secondary labels, nav items" },
        "subtle":       { "$type": "color", "$value": "{color.primitive.neutral.400}", "$description": "Axis labels, placeholders. NOT on elevated surfaces" },
        "on-primary":   { "$type": "color", "$value": "{color.primitive.neutral.0}", "$description": "Text on action.primary fills and on danger/avatar fills" },
        "on-secondary": { "$type": "color", "$value": "{color.primitive.neutral.0}", "$description": "Text on action.secondary fills" }
      },
      "action": {
        "primary":        { "$type": "color", "$value": "{color.primitive.blue.500}", "$description": "FILLS only: primary buttons, active nav item, solid badges. Never as text" },
        "primary-hover":  { "$type": "color", "$value": "{color.primitive.blue.450}" },
        "primary-active": { "$type": "color", "$value": "{color.primitive.blue.600}" },
        "primary-text":   { "$type": "color", "$value": "{color.primitive.blue.300}", "$description": "Links and icons in primary color. NOT on elevated surfaces" },
        "secondary":      { "$type": "color", "$value": "{color.primitive.violet.500}", "$description": "Secondary accent fills (badges). Use sparingly" },
        "secondary-text": { "$type": "color", "$value": "{color.primitive.violet.300}" }
      },
      "subtle": {
        "primary":   { "$type": "color", "$value": "{color.primitive.tint.primary}", "$description": "Selected / highlighted background. Text on it must be text.primary" },
        "secondary": { "$type": "color", "$value": "{color.primitive.tint.secondary}" }
      },
      "status": {
        "success":        { "$type": "color", "$value": "{color.primitive.green.500}" },
        "success-subtle": { "$type": "color", "$value": "{color.primitive.tint.success}" },
        "warning":        { "$type": "color", "$value": "{color.primitive.amber.500}" },
        "warning-subtle": { "$type": "color", "$value": "{color.primitive.tint.warning}" },
        "danger":         { "$type": "color", "$value": "{color.primitive.red.600}", "$description": "Destructive fills and error borders. Red is ONLY for errors/destructive" },
        "danger-text":    { "$type": "color", "$value": "{color.primitive.red.400}" },
        "danger-subtle":  { "$type": "color", "$value": "{color.primitive.tint.danger}" },
        "info":           { "$type": "color", "$value": "{color.primitive.cyan.400}", "$description": "Informational. Must stay visually distinct from primary" },
        "info-subtle":    { "$type": "color", "$value": "{color.primitive.tint.info}" }
      },
      "data": {
        "series-1": { "$type": "color", "$value": "{color.primitive.indigo.500}" },
        "series-2": { "$type": "color", "$value": "{color.primitive.blue.500}" },
        "series-3": { "$type": "color", "$value": "{color.primitive.violet.300}", "$description": "Chart series uses violet.300: violet.500 fails 3:1 on surfaces (WCAG 1.4.11)" },
        "series-4": { "$type": "color", "$value": "{color.primitive.cyan.400}" },
        "avatar":   { "$type": "color", "$value": "{color.primitive.indigo.700}", "$description": "Default avatar fill (text.on-primary on top)" }
      },
      "focus-ring": { "$type": "color", "$value": "{color.primitive.blue.300}" }
    }
  },
  "font": {
    "family": { "sans": { "$type": "fontFamily", "$value": ["Inter", "system-ui", "-apple-system", "Segoe UI", "sans-serif"], "$description": "PROVISIONAL: confirm typeface" } },
    "size": {
      "caption": { "$type": "dimension", "$value": "12px" },
      "label":   { "$type": "dimension", "$value": "13px" },
      "body":    { "$type": "dimension", "$value": "14px" },
      "title":   { "$type": "dimension", "$value": "16px" },
      "heading": { "$type": "dimension", "$value": "24px" },
      "metric":  { "$type": "dimension", "$value": "32px" }
    },
    "line-height": {
      "caption": { "$type": "dimension", "$value": "16px" },
      "label":   { "$type": "dimension", "$value": "20px" },
      "body":    { "$type": "dimension", "$value": "20px" },
      "title":   { "$type": "dimension", "$value": "24px" },
      "heading": { "$type": "dimension", "$value": "32px" },
      "metric":  { "$type": "dimension", "$value": "40px" }
    },
    "weight": {
      "regular":  { "$type": "fontWeight", "$value": 400 },
      "medium":   { "$type": "fontWeight", "$value": 500 },
      "semibold": { "$type": "fontWeight", "$value": 600 },
      "bold":     { "$type": "fontWeight", "$value": 700 }
    }
  },
  "space": {
    "1": { "$type": "dimension", "$value": "4px" },
    "2": { "$type": "dimension", "$value": "8px" },
    "3": { "$type": "dimension", "$value": "12px" },
    "4": { "$type": "dimension", "$value": "16px" },
    "5": { "$type": "dimension", "$value": "20px" },
    "6": { "$type": "dimension", "$value": "24px" },
    "8": { "$type": "dimension", "$value": "32px" }
  },
  "radius": {
    "control": { "$type": "dimension", "$value": "8px" },
    "card":    { "$type": "dimension", "$value": "12px" },
    "pill":    { "$type": "dimension", "$value": "9999px" }
  },
  "layout": {
    "sidebar-width": { "$type": "dimension", "$value": "240px" },
    "content-max":   { "$type": "dimension", "$value": "1200px" }
  },
  "border-width": {
    "default": { "$type": "dimension", "$value": "1px" },
    "focus":   { "$type": "dimension", "$value": "2px" }
  },
  "opacity": {
    "disabled": { "$type": "number", "$value": 0.4 }
  }
}
